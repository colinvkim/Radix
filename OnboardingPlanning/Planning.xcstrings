    "The workspace opens without a tour. The user can start it later from Help.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace opens without a tour. The user can start it later from Help."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich öffnet sich ohne Einführung. Sie kann später über „Hilfe“ gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo se abre sin visita. Se puede iniciar más tarde desde Ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de travail s’ouvre sans visite. Elle pourra être lancée plus tard depuis Aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di lavoro si apre senza tour. Il tour può essere avviato in seguito da Aiuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区将直接打开，不开始导览。用户可以稍后从“帮助”菜单启动。"
          }
        }
      }
    },
    "This planner ends at the handoff. The tour will use the real workspace, with prompts beside the controls the user is learning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This planner ends at the handoff. The tour will use the real workspace, with prompts beside the controls the user is learning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorschau endet beim Übergang. Die Einführung wird im echten Arbeitsbereich stattfinden, mit Hinweisen neben den jeweiligen Bedienelementen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este prototipo termina en la transición. La visita usará el espacio de trabajo real, con indicaciones junto a los controles que se están aprendiendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce prototype s’arrête à la transition. La visite utilisera l’espace de travail réel, avec des indications à côté des commandes à découvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo prototipo termina al passaggio allo spazio di lavoro. Il tour userà l’interfaccia reale, con suggerimenti accanto ai comandi da imparare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此规划预览到交接处结束。导览将使用真实工作区，在用户正在学习的控件旁显示提示。"
          }
        }
      }
    },

    "In Radix, this action opens System Settings. Here, choose the state you want to preview when you return.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Radix, this action opens System Settings. Here, choose the state you want to preview when you return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Radix öffnet diese Aktion die Systemeinstellungen. Wähle hier den Zustand für die Vorschau nach der Rückkehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Radix, esta acción abre Ajustes del Sistema. Aquí, elige el estado que quieres ver al volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Radix, cette action ouvre Réglages Système. Ici, choisissez l’état à prévisualiser à votre retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Radix, questa azione apre Impostazioni di Sistema. Qui, scegli lo stato da visualizzare al ritorno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Radix 中，此操作会打开系统设置。在这里，选择返回时要预览的权限状态。"
          }
        }
      }
    },
    "Informational tips advance with Next. Adding items and opening the Discard Pile advance the exercise. The user can stop at any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Informational tips advance with Next. Adding items and opening the Discard Pile advance the exercise. The user can stop at any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise werden mit „Weiter“ fortgesetzt. Das Hinzufügen von Objekten und Öffnen der Löschliste führt die Übung weiter. Die Einführung kann jederzeit beendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los consejos informativos avanzan con Siguiente. Añadir elementos y abrir la pila de descarte hace avanzar el ejercicio. La visita se puede detener en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conseils avancent avec Suivant. L’ajout d’éléments et l’ouverture de la pile de suppression font avancer l’exercice. La visite peut être arrêtée à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suggerimenti informativi avanzano con Avanti. Aggiungere elementi e aprire l’elenco di eliminazione fa avanzare l’esercizio. Il tour può essere interrotto in qualsiasi momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息提示通过“下一步”继续。添加项目和打开待处理列表会推进练习。用户随时可以结束导览。"
          }
        }
      }
    },

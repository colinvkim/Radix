    "Explore Radix with sample files. Get to know the controls, then try the Discard Pile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore Radix with sample files. Get to know the controls, then try the Discard Pile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde Radix mit Beispieldateien. Lerne die Bedienelemente kennen und probiere dann die Löschliste aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora Radix con archivos de ejemplo. Conoce los controles y prueba la pila de descarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez Radix avec des fichiers d’exemple. Découvrez les commandes, puis essayez la pile de suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora Radix con file di esempio. Scopri i comandi, poi prova l’elenco di eliminazione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用示例文件探索 Radix。了解各个控件，然后试用待处理列表。"
          }
        }
      }
    },

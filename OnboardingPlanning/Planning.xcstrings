    "Use short prompts beside the disk map, view switcher, search, and inspector.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use short prompts beside the disk map, view switcher, search, and inspector."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Hinweise neben Datenträgerkarte, Ansichtsumschalter, Suche und Informationsbereich anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa indicaciones breves junto al mapa, el selector de vistas, la búsqueda y el inspector."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher de courtes indications près de la carte, du sélecteur de vue, de la recherche et de l’inspecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevi suggerimenti accanto alla mappa, al selettore di vista, alla ricerca e all’inspector."

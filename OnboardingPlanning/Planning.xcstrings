    "Explore your files visually, find the large ones, and decide what to keep.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore your files visually, find the large ones, and decide what to keep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde deine Dateien grafisch, finde die großen und entscheide, was bleiben soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora tus archivos visualmente, encuentra los más grandes y decide qué conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez vos fichiers visuellement, repérez les plus volumineux et décidez quoi garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora i file visivamente, trova quelli più grandi e decidi cosa tenere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直观地浏览文件，找出大文件，再决定保留哪些。"

        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在刷新比较"
          }
        }
      }
    },
    "Retry": {
      "comment": "Button that retries a failed disk-map layout.",
      "localizations": {
        "de": {
          "stringUnit": {

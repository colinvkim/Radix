{
  "sourceLanguage": "en",
  "strings": {
    "Attempts to load the disk map again.": {
      "comment": "Accessibility hint for retrying a failed disk-map layout.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versucht erneut, die Datenträgerkarte zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta cargar de nuevo el mapa de disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente de charger à nouveau la carte du disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta di caricare nuovamente la mappa del disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次尝试加载磁盘图。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторная попытка загрузить карту диска."
          }
        }
      }
    },
    "Couldn’t Load Disk Map": {
      "comment": "Heading shown when a disk-map layout could not be generated.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenträgerkarte konnte nicht geladen werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el mapa de disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la carte du disque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la mappa del disco"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载磁盘图"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить карту диска"
          }
        }
      }
    },
    "Disk map layout failed": {
      "comment": "Accessibility label for a failed disk-map layout banner.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout der Datenträgerkarte fehlgeschlagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en el diseño del mapa de disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la disposition de la carte du disque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout della mappa del disco non riuscito"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘图布局失败"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось построить карту диска"
          }
        }
      }
    },
    "Loading changes…": {
      "comment": "Progress message shown while comparison changes are loading.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden geladen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando cambios…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des modifications…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento delle modifiche…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载更改…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка изменений…"
          }
        }
      }
    },
    "No net change": {
      "comment": "Accessibility label for a comparison aggregate whose net size change is zero.",

    "Disable file cleanup actions while browsing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disable file cleanup actions while browsing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert Aktionen zur Dateibereinigung beim Durchsuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las acciones de limpieza de archivos mientras exploras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive les actions de nettoyage des fichiers pendant la navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabilita le azioni di pulizia dei file durante la navigazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключает действия по очистке файлов при просмотре."

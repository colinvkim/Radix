          }
        }
      }
    },
    "Radix could not verify Full Disk Access on this Mac. You can still scan ordinary folders." : {
      "comment" : "Onboarding status shown when Full Disk Access cannot be determined.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix konnte den Festplattenvollzugriff auf diesem Mac nicht überprüfen. Sie können weiterhin gewöhnliche Ordner scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no pudo verificar el Acceso total al disco en este Mac. Aún puedes analizar carpetas normales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix n’a pas pu vérifier l’accès complet au disque sur ce Mac. Vous pouvez toujours analyser les dossiers ordinaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non ha potuto verificare l'Accesso completo al disco su questo Mac. È comunque possibile scansionare le cartelle normali."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 无法验证这台 Mac 的完全磁盘访问权限。你仍可扫描普通文件夹。"
          }
        }
      }
    },
    "Radix could not verify the current identity for %@: %@" : {
      "comment" : "Safety error shown when the current file identity cannot be verified.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix konnte die aktuelle Identität für %@ nicht überprüfen: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Radix could not verify the current identity for %1$@: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no pudo verificar la identidad actual de %@: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix n’a pas pu vérifier l’identité actuelle de %@ : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non ha potuto verificare l'identità corrente per %1$@: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 无法验证 %@ 的当前身份：%@"
          }
        }
      }
    },
    "Radix could not verify the scanned identity for %@. Rescan before moving it to Trash." : {
      "comment" : "Safety error shown when a scanned file identity cannot be verified.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix konnte die Identität des Scans für %@ nicht überprüfen. Scannen Sie erneut, bevor Sie das Element in den Papierkorb bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no pudo verificar la identidad analizada de %@. Vuelve a analizarlo antes de moverlo a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix n’a pas pu vérifier l’identité analysée de %@. Réanalysez-le avant de le placer dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non ha potuto verificare l'identità scansionata per %@. Esegui nuovamente la scansione prima di spostarlo nel Cestino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 无法验证 %@ 的扫描身份。移到废纸篓前请重新扫描。"
          }
        }
      }
    },
    "Radix couldn’t safely apply the recent changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix konnte die letzten Änderungen nicht sicher übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no pudo aplicar de forma segura los cambios recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix n’a pas pu appliquer les modifications récentes en toute sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non ha potuto applicare in modo sicuro le modifiche recenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 无法安全地应用最近的更改。"
          }
        }
      }
    },
    "Radix does not currently have Full Disk Access. Normal scans still work; protected folders may be skipped." : {
      "comment" : "Onboarding status shown when Full Disk Access is not granted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix verfügt derzeit nicht über den Festplattenvollzugriff. Normale Scans funktionieren weiterhin; geschützte Ordner werden möglicherweise übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no tiene Acceso total al disco. Los análisis normales siguen funcionando; es posible que se omitan las carpetas protegidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix ne dispose pas actuellement de l’accès complet au disque. Les analyses normales fonctionnent toujours ; les dossiers protégés peuvent être ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non dispone attualmente dell'Accesso completo al disco. Le scansioni normali funzionano comunque; le cartelle protette potrebbero essere saltate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 当前没有完全磁盘访问权限。普通扫描仍可运行，但可能跳过受保护的文件夹。"
          }
        }
      }
    },
    "Radix grouped this folder during the scan. Expand it to inspect individual items." : {
      "comment" : "Inspector explanation for a summarized folder.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix hat diesen Ordner beim Scan gruppiert. Erweitere ihn, um einzelne Elemente zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix agrupó esta carpeta durante el análisis. Expándela para inspeccionar los elementos individuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix a regroupé ce dossier pendant l’analyse. Développez-le pour inspecter les éléments individuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix ha raggruppato questa cartella durante la scansione. Espandila per esaminare i singoli elementi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

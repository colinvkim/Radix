    },
    "This clears locally stored aggregate usage stats on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die lokal auf diesem Mac gespeicherten zusammengefassten Nutzungsstatistiken gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra las estadísticas de uso agregadas almacenadas localmente en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action efface les statistiques d’utilisation agrégées stockées localement sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancella le statistiche di utilizzo aggregate memorizzate localmente su questo Mac."
          }
        },
        "zh-Hans" : {

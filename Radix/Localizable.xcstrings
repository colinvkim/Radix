    "The map and file list now show this folder’s contents. Use the path to return to a parent folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map and file list now show this folder’s contents. Use the path to return to a parent folder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte und die Dateiliste zeigen jetzt den Inhalt dieses Ordners. Über den Pfad kannst du zu einem übergeordneten Ordner zurückkehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa y la lista de archivos muestran ahora el contenido de esta carpeta. Usa la ruta para volver a una carpeta superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte et la liste de fichiers affichent maintenant le contenu de ce dossier. Utilisez le chemin pour revenir à un dossier parent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa e l’elenco dei file ora mostrano il contenuto di questa cartella. Usa il percorso per tornare a una cartella superiore."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘图和文件列表现在显示此文件夹的内容。使用路径返回上级文件夹。"
          }
        }
      }
    }

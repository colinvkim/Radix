          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描目标现在位于另一个宗卷上。"
          }
        }
      }
    },
    "The scanned volume itself cannot be added to the Discard Pile or moved to Trash." : {
      "comment" : "Inspector notice explaining scan-root action limits.",
      "localizations" : {
        "de" : {
          "stringUnit" : {

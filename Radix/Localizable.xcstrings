    },
    "The map and file list now show this folder’s contents. Use the path to return to a parent folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte und die Dateiliste zeigen jetzt den Inhalt dieses Ordners. Über den Pfad können Sie zu einem übergeordneten Ordner zurückkehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map and file list now show this folder’s contents. Use the path to return to a parent folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa y la lista de archivos muestran ahora el contenido de esta carpeta. Usa la ruta para volver a una carpeta superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte et la liste de fichiers affichent maintenant le contenu de ce dossier. Utilisez le chemin pour revenir à un dossier parent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa e l’elenco dei file ora mostrano il contenuto di questa cartella. Usa il percorso per tornare a una cartella superiore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь карта и список файлов показывают содержимое этой папки. Используйте строку пути, чтобы вернуться в родительскую папку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘图和文件列表现在显示此文件夹的内容。使用路径返回上级文件夹。"
          }
        }
      }
    },
    "The map shows how your disk space is used. Selecting an item in the map or Contents highlights it in both." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte zeigt, wie Ihr Datenträger belegt ist. Wenn Sie ein Element in der Karte oder unter „Inhalt“ auswählen, wird es in beiden Ansichten hervorgehoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map shows how your disk space is used. Selecting an item in the map or Contents highlights it in both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa muestra cómo se utiliza el espacio del disco. Al seleccionar un elemento en el mapa o en Contenido, se resalta en ambas vistas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte montre comment l’espace disque est utilisé. Sélectionner un élément dans la carte ou dans Contenu le met en surbrillance dans les deux vues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa mostra come viene utilizzato lo spazio su disco. Selezionando un elemento nella mappa o in Contenuto, lo evidenzi in entrambe le viste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта показывает, как используется место на диске. При выборе объекта на карте или в разделе «Содержимое» он выделяется в обоих представлениях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘图显示磁盘空间的使用情况。在磁盘图或“内容”中选择项目，会在两个视图中同时高亮显示该项目。"
          }
        }
      }
    },
    "The minus (–) button removes an item from the Discard Pile. It reappears in the folder view and is no longer marked for deletion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Minustaste (–) entfernt ein Element aus der Löschliste. Es erscheint wieder in der Ordneransicht und ist nicht mehr zum Löschen vorgemerkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minus (–) button removes an item from the Discard Pile. It reappears in the folder view and is no longer marked for deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón menos (–) quita un elemento de la pila de descarte. Vuelve a aparecer en la vista de la carpeta y ya no está marcado para su eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton moins (–) retire un élément de la pile de suppression. Il réapparaît dans la vue du dossier et n’est plus marqué pour suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante meno (–) rimuove un elemento dall’elenco di eliminazione. L’elemento riappare nella vista della cartella e non è più contrassegnato per l’eliminazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «минус» (–) удаляет объект из списка на удаление. Он снова появляется в содержимом папки и больше не отмечен для удаления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减号（–）按钮会将项目从待处理列表中移除。该项目会重新显示在文件夹视图中，并且不再被标记为待删除。"
          }
        }
      }
    },
    "The previous scan can’t be safely reused." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der vorherige Scan kann nicht sicher wiederverwendet werden."

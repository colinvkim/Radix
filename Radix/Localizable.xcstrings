    },
    "This item does not support that action." : {
      "comment" : "Error shown when a selected item cannot perform the requested action.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Element unterstützt diese Aktion nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento no admite esa acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément ne prend pas en charge cette action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento non supporta questa azione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目不支持该操作。"
          }
        }
      }
    },
    "This item is marked for review. It remains on disk until you move the Discard Pile to Trash." : {
      "comment" : "Inspector explanation for an item directly added to the Discard Pile.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Element ist zur Überprüfung markiert. Es bleibt auf dem Datenträger, bis die Löschliste in den Papierkorb bewegt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento está marcado para revisión. Permanecerá en el disco hasta que muevas la pila de descarte a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément est marqué pour vérification. Il reste sur le disque jusqu’à ce que vous déplaciez la pile de suppression vers la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento è contrassegnato per la revisione. Rimane sul disco finché non sposti l'elenco di eliminazione nel Cestino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目已标记以供检查。在您将待处理列表移到废纸篓之前，它会一直保留在磁盘上。"
          }
        }
      }
    },
    "This location is protected from removal. You can still open it or reveal it in Finder." : {
      "comment" : "Inspector notice explaining protected-location action limits.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort ist vor dem Entfernen geschützt. Er kann weiterhin geöffnet oder im Finder angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ubicación está protegida contra la eliminación. Aún puedes abrirla o mostrarla en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet emplacement est protégé contre la suppression. Vous pouvez toujours l’ouvrir ou l’afficher dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa posizione è protetta dalla rimozione. Puoi comunque aprirla o mostrarla nel Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位置受保护，无法移除。你仍可打开它或在“访达”中显示它。"
          }
        }
      }
    },
    "This removes all marked items from the Discard Pile. Files on disk are unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle markierten Elemente aus der Löschliste entfernt. Dateien auf dem Datenträger bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los elementos marcados de la pila de descarte. Los archivos del disco no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime tous les éléments marqués de la pile de suppression. Les fichiers sur le disque restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove tutti gli elementi contrassegnati dall'elenco di eliminazione. I file sul disco non vengono modificati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从待处理列表中移除所有标记项目。磁盘上的文件不会更改。"
          }
        }
      }
    },
    "This selection comes from a saved scan. Removal actions are unavailable." : {
      "comment" : "Inspector notice explaining saved-scan action limits.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Auswahl stammt aus einem gespeicherten Scan. Aktionen zum Entfernen sind nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {

          }
        }
      }
    },
    "The minus (–) button removes an item from the Discard Pile. It reappears in the folder view and is no longer marked for deletion." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The minus (–) button removes an item from the Discard Pile. It reappears in the folder view and is no longer marked for deletion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Minustaste (–) entfernt ein Objekt aus der Löschliste. Es erscheint wieder in der Ordneransicht und ist nicht mehr zum Löschen vorgemerkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón menos (–) quita un elemento de la pila de descarte. Vuelve a aparecer en la vista de la carpeta y ya no está marcado para su eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton moins (–) retire un élément de la pile de suppression. Il réapparaît dans la vue du dossier et n’est plus marqué pour suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante meno (–) rimuove un elemento dall’elenco di eliminazione. L’elemento riappare nella vista della cartella e non è più contrassegnato per l’eliminazione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减号（–）按钮会将项目从待处理列表中移除。该项目会重新显示在文件夹视图中，并且不再被标记为待删除。"
          }
        }
      }
    },
    "Sunburst uses rings; Treemap uses rectangles. Both show how your disk space is used." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunburst uses rings; Treemap uses rectangles. Both show how your disk space is used."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunburst verwendet Ringe, Treemap Rechtecke. Beide zeigen die Belegung deines Festplattenspeichers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radial usa anillos; Mapa de árbol usa rectángulos. Ambas vistas muestran cómo se utiliza el espacio del disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunburst utilise des anneaux et Treemap des rectangles. Les deux vues montrent comment l’espace disque est utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunburst usa anelli, Treemap usa rettangoli. Entrambe le viste mostrano come viene utilizzato lo spazio su disco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旭日图使用圆环，矩形树图使用矩形。两种视图都显示磁盘空间的使用情况。"
          }
        }
      }
    },
    "You can also select an item and choose Inspect > Add to Discard Pile (⇧⌘L)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also select an item and choose Inspect > Add to Discard Pile (⇧⌘L)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst auch ein Objekt auswählen und „Untersuchen > Zur Löschliste hinzufügen“ (⇧⌘L) wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes seleccionar un elemento y elegir Inspeccionar > Añadir a la pila de descarte (⇧⌘L)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi sélectionner un élément et choisir Inspecter > Ajouter à la pile de suppression (⇧⌘L)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche selezionare un elemento e scegliere Ispeziona > Aggiungi all’elenco di eliminazione (⇧⌘L)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你也可以选择项目，然后选取“检查”>“加入待处理列表”（⇧⌘L）。"
          }
        }
      }
    },

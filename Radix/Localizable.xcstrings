    },
    "Radix is scanning the entire location to ensure accurate results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix scannt den gesamten Speicherort, um genaue Ergebnisse zu gewährleisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix está analizando toda la ubicación para garantizar resultados precisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix analyse l’emplacement entier afin de garantir des résultats exacts."
          }

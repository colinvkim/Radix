    "The Inspector shows details about the selected item. This button shows or hides it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Inspektor zeigt Details zum ausgewählten Element. Diese Taste blendet ihn ein oder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Inspector shows details about the selected item. This button shows or hides it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Inspector muestra los detalles del elemento seleccionado. Este botón lo muestra u oculta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inspecteur affiche les détails de l’élément sélectionné. Ce bouton permet de l’afficher ou de le masquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Inspector mostra i dettagli dell’elemento selezionato. Questo pulsante lo mostra o lo nasconde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

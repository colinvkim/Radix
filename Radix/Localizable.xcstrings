    "Removes recent locations from the sidebar. Your files and saved scan snapshots are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die zuletzt verwendeten Speicherorte aus der Seitenleiste. Dateien und gespeicherte Scan-Snapshots bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes recent locations from the sidebar. Your files and saved scan snapshots are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina las ubicaciones recientes de la barra lateral. Se conservan tus archivos y las instantáneas de análisis guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les emplacements récents de la barre latérale. Vos fichiers et les instantanés d’analyse enregistrés sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le posizioni recenti dalla barra laterale. I file e le istantanee di scansione salvate vengono mantenuti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет недавние расположения с боковой панели. Файлы и сохранённые снимки сканирования сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从边栏移除最近的位置。文件和已保存的扫描快照将保留。"
          }
        }
      }
    },
    "Replace…" : {

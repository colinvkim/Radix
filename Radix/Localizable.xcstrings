    "File allocations overlap by %lld bytes; APFS clones or files changed during the scan may share physical storage." : {
      "comment" : "Scan warning about overlapping allocated storage.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateizuweisungen überschneiden sich um %lld Bytes; APFS-Klone oder während des Scans geänderte Dateien nutzen möglicherweise gemeinsamen physischen Speicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File allocations overlap by %lld bytes; APFS clones or files changed during the scan may share physical storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las asignaciones de archivos se solapan en %lld bytes; los clones APFS o los archivos modificados durante el análisis pueden compartir almacenamiento físico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les allocations de fichiers se chevauchent sur %lld octets ; les clones APFS ou les fichiers modifiés pendant l’analyse peuvent partager du stockage physique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le allocazioni dei file si sovrappongono per %lld byte; i cloni APFS o i file modificati durante la scansione potrebbero condividere spazio fisico."

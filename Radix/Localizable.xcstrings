        }
      }
    },
    "This is expected on macOS." : {
      "comment" : "Inspector guidance that a protected system location is normal macOS behavior.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist unter macOS zu erwarten."
          }

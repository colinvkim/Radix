    "Restores scan, disk map, and update preferences to their defaults, and replaces custom exclusion patterns with the built-in presets. Recent scans, stats, and Full Disk Access are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Scan-, Datenträgerkarten- und Update-Einstellungen auf die Standardwerte zurück und ersetzt eigene Ausschlussmuster durch die integrierten Vorgaben. Letzte Scans, Statistiken und Festplattenvollzugriff bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores scan, disk map, and update preferences to their defaults, and replaces custom exclusion patterns with the built-in presets. Recent scans, stats, and Full Disk Access are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura los ajustes predeterminados de análisis, mapas de disco y actualizaciones, y sustituye los patrones de exclusión personalizados por los predefinidos. Se conservan los análisis recientes, las estadísticas y el acceso total al disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit les réglages par défaut des analyses, des cartes du disque et des mises à jour, et remplace les motifs d’exclusion personnalisés par les préréglages intégrés. Les analyses récentes, les statistiques et l’accès complet au disque sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina le preferenze predefinite di scansione, mappe del disco e aggiornamenti e sostituisce i criteri di esclusione personalizzati con quelli predefiniti. Scansioni recenti, statistiche e accesso completo al disco vengono mantenuti."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает настройки сканирования, карты диска и обновлений к значениям по умолчанию, а пользовательские шаблоны исключений заменяет встроенными. Недавние сканирования, статистика и полный доступ к диску сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将扫描、磁盘图和更新偏好设置恢复为默认值，并用内置预设替换自定义排除模式。最近扫描、统计数据和完全磁盘访问权限将保留。"
          }
        }
      }
    },
    "Reveal in Finder" : {
      "comment" : "File action that shows the selected item in Finder.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Finder anzeigen"
          }
        },
        "es" : {

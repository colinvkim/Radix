    "Drag a sample file or folder from the map or Contents to the Discard Pile. This marks it for review without moving or deleting it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie eine Beispieldatei oder einen Beispielordner aus der Karte oder aus „Inhalt“ in die Löschliste. Das Element wird zur Prüfung vorgemerkt, ohne es zu verschieben oder zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a sample file or folder from the map or Contents to the Discard Pile. This marks it for review without moving or deleting it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un archivo o una carpeta de ejemplo desde el mapa o Contenido a la pila de descarte. El elemento se marca para revisión, sin moverlo ni eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez un fichier ou un dossier d’exemple depuis la carte ou Contenu vers la pile de suppression. L’élément est marqué pour examen, sans être déplacé ni supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un file o una cartella di esempio dalla mappa o da Contenuto all’elenco di eliminazione. L’elemento viene contrassegnato per la revisione, senza spostarlo né eliminarlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите пример файла или папки с карты или из раздела «Содержимое» в список на удаление. Объект будет отмечен для проверки, но не будет перемещён или удалён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将示例文件或文件夹从磁盘图或“内容”拖入待处理列表。这只会将其标记为待查看，不会移动或删除它。"
          }
        }
      }
    },
    "Drag items into the Discard Pile and review them" : {
      "extractionState" : "manual",
      "localizations" : {

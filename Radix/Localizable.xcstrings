          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’analyse précédente ne peut pas être réutilisée en toute sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scansione precedente non può essere riutilizzata in modo sicuro."
          }

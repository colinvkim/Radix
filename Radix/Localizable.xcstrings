    "%lld items • %@" : {
      "comment" : "Discard Pile status showing the marked item count and total allocated size. The item count controls pluralization.\nDiscard Pile subtitle showing the marked item count and total allocated size. The item count controls pluralization.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Element • %2$@"
                }
